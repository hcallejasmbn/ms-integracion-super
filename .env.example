# Copiar a .env y completar los valores

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://usuario:clave@localhost:5432/ms_integracion_super

# Mi Súper
HOST_SUPER=https://services.super.gob.cl
PATH_TOKEN_SUPER=api/v1/api-token-auth
PATH_APPLICATIONS_SUPER=api/v2/applications/
MISUPER_API_KEY=
MISUPER_CHILE_ATIENDE_ID=

# SSO de Azure (Microsoft Entra ID). Redirect URI a registrar en Azure como plataforma "Web".
# Incluye el basePath /ms-integracion-super (src/config/base-path.ts)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3000/ms-integracion-super/api/auth/callback
# Clave de al menos 32 caracteres para cifrar la cookie de sesión: openssl rand -base64 32
SESION_SECRET=
# Opcional; por defecto 8
SESION_DURACION_HORAS=8

# Job de notificación a SUPER. Todas son opcionales; estos son sus valores por defecto
JOB_NOTIFICACION_SUPER_ACTIVO=true
# minuto hora día mes día-semana
JOB_NOTIFICACION_SUPER_CRON=0 3 * * *
JOB_ZONA_HORARIA=America/Santiago

# Tests de integración: "true" crea una solicitud real en Mi Súper (pnpm test:integration)
MISUPER_INTEGRATION_CREAR_SOLICITUD=false

# Docker (cicd/docker-compose.yml). Todas son opcionales; estos son sus valores por defecto
# "true" crea el esquema y aplica las migraciones al iniciar el contenedor
DB_MIGRAR_AL_INICIAR=true
APP_PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ms_integracion_super
POSTGRES_PORT=5435
